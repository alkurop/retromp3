<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/grayish"
    android:clickable="true"
    android:focusable="true"
    android:paddingBottom="4dp">

    <com.github.alkurop.rangebar.RangeBar
        android:id="@+id/range_bar"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:barWeight="1dp"
        app:connectingLineColor="#fff"
        app:connectingLineWeight="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:thumbRadius="3dp"
        app:tickCount="100"
        app:tickHeight="0dp" />

    <TextView
        android:id="@+id/range_start"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textAppearance="@style/Control.Small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/range_bar"
        tools:text="start" />

    <TextView
        android:id="@+id/range_state"
        style="@style/Control.Normal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/range_end"
        app:layout_constraintStart_toEndOf="@id/range_start"
        app:layout_constraintTop_toBottomOf="@id/range_bar"
        tools:text="Range" />

    <TextView
        android:id="@+id/range_end"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:gravity="end"
        android:minWidth="120dp"
        android:textAppearance="@style/Control.Small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/range_bar"
        tools:text="end" />

</androidx.constraintlayout.widget.ConstraintLayout>
