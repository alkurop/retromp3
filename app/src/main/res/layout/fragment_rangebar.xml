<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:background="@color/color_visualizer_bg"
    android:paddingBottom="4dp"
    android:focusable="true">

    <com.github.alkurop.rangebar.RangeBar
        android:id="@+id/range_bar"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        app:barWeight="1dp"
        app:connectingLineWeight="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:thumbRadius="2dp"
        app:tickCount="100"
        app:tickHeight="0dp" />

    <TextView
        android:id="@+id/range_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:minWidth="100dp"
        tools:text="start"
        android:textAppearance="@style/Control.Small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/range_bar" />

    <TextView
        android:id="@+id/range_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:gravity="end"
        android:minWidth="100dp"
        tools:text="end"
        android:textAppearance="@style/Control.Small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/range_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>